{
  "name": "simple-training",
  "private": true,
  "version": "3.7.0",
  "description": "Simple Training: plan and log your workouts. Offline PWA, data stays on the device.",
  "author": "Fovae & Claude",
  "type": "module",
  "scripts": {
    "dev": "node scripts/licenses.mjs && vite",
    "build": "node scripts/i18n-check.mjs && node scripts/theme-check.mjs && node scripts/legal-check.mjs && node scripts/licenses.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "node scripts/licenses.mjs && tsc --noEmit",
    "test:e2e": "playwright test",
    "i18n:check": "node scripts/i18n-check.mjs",
    "theme:check": "node scripts/theme-check.mjs",
    "themes:sheet": "npm run build && node scripts/themes-sheet.mjs",
    "legal:check": "node scripts/legal-check.mjs",
    "licenses": "node scripts/licenses.mjs",
    "pics:sheet": "node scripts/pics-sheet.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@preact/signals": "^2.11.4",
    "idb": "^8.0.4",
    "preact": "^10.29.8",
    "valibot": "^1.5.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  }
}
